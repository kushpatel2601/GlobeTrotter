    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
